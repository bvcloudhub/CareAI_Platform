CAREAI_SECRET_KEY=
CAREAI_ENV=development
CAREAI_DB_PATH=careai.db
CAREAI_LLM_MODE=mock
# CAREAI_LLM_API_KEY=
# CAREAI_LLM_ENDPOINT=


# Hospital Hybrid AI. Safe defaults keep external AI and background jobs OFF.
CAREAI_ENABLE_SCHEDULER=0
# 1 is on and 0 is off uses of OpenAI
CAREAI_USE_OPENAI=0
CAREAI_RAG_MODE=tfidf
OPENAI_API_KEY=
# Set an OpenAI API model only when CAREAI_USE_OPENAI=1.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small




# Local web server. Keep 127.0.0.1 for browser-only use.
# For a physical iPhone on the same Wi-Fi, use CAREAI_HOST=0.0.0.0
# and connect the iPhone app to http://<WINDOWS-LAN-IP>:5002.
CAREAI_HOST=127.0.0.1
CAREAI_PORT=5002

# Wearable API. Pair each phone/device to one patient with:
# python scripts/pair_wearable.py NL-CR-003 --label "Patient iPhone"
CAREAI_WEARABLE_API_ENABLED=1
