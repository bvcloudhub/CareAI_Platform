{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "careai://schemas/device-adapters/generic_ecg_patch/1.0",
  "title": "CareAI Generic ECG Patch Payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "patient_id", "device_type", "device_identifier", "source", "measurement_timestamp", "measurements"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "patient_id": {"type": "string", "minLength": 1},
    "device_type": {"const": "generic_ecg_patch"},
    "device_identifier": {"type": "string", "minLength": 1, "maxLength": 160},
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "name"],
      "properties": {
        "type": {"enum": ["simulated", "vendor_api", "ble_gateway", "manual_json", "api"]},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "measurement_timestamp": {"type": "string", "format": "date-time"},
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heart_rate"],
      "properties": {
        "heart_rate": {
          "type": "object",
          "required": ["value", "unit"],
          "properties": {"value": {"type": "number", "minimum": 20, "maximum": 250}, "unit": {"const": "bpm"}}
        },
        "rr_interval": {
          "type": "object",
          "required": ["value", "unit"],
          "properties": {"value": {"type": "number", "minimum": 150, "maximum": 4000}, "unit": {"const": "ms"}}
        },
        "pr_interval": {
          "type": "object",
          "required": ["value", "unit"],
          "properties": {"value": {"type": "number", "minimum": 60, "maximum": 500}, "unit": {"const": "ms"}}
        },
        "qrs_duration": {
          "type": "object",
          "required": ["value", "unit"],
          "properties": {"value": {"type": "number", "minimum": 30, "maximum": 300}, "unit": {"const": "ms"}}
        },
        "qt_interval": {
          "type": "object",
          "required": ["value", "unit"],
          "properties": {"value": {"type": "number", "minimum": 150, "maximum": 800}, "unit": {"const": "ms"}}
        },
        "qtc": {
          "type": "object",
          "required": ["value", "unit"],
          "properties": {"value": {"type": "number", "minimum": 150, "maximum": 800}, "unit": {"const": "ms"}}
        },
        "rhythm": {
          "type": "object",
          "required": ["value", "unit"],
          "properties": {"value": {"type": "string", "maxLength": 160}, "unit": {"const": "label"}}
        }
      }
    },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lead", "sampling_rate_hz", "duration_seconds", "amplitude_unit", "samples"],
      "properties": {
        "lead": {"type": "string", "minLength": 1, "maxLength": 50},
        "sampling_rate_hz": {"type": "integer", "minimum": 100, "maximum": 1000},
        "duration_seconds": {"type": "number", "minimum": 1, "maximum": 60},
        "amplitude_unit": {"const": "mV"},
        "samples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 60000,
          "items": {"type": "number", "minimum": -20, "maximum": 20}
        }
      }
    }
  }
}
